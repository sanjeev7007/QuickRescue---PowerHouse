# ==========================================
# QuickRescue Monorepo .gitignore
# PlatformIO, Python (Raspberry Pi), Node.js (React)
# ==========================================

# --- General & OS ---
.DS_Store
Thumbs.db
*.bak
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# --- PlatformIO & Embedded (Handy Device) ---
.pio/
.pioenvs/
.piolibdeps/
.clangd/
*.bin
*.hex
*.elf

# --- Python (Communication Tower) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Node.js & React (Dashboard) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dashboard/build/
dashboard/dist/
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Environment & Secret Credentials ---
.env
*.pem
*.key
serviceAccountKey.json
firebase-adminsdk*.json
