[Unit]
Description=QuickRescue Communication Tower Local REST API Service
After=network.target quickrescue-receiver.service
Wants=quickrescue-receiver.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/quickrescue
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/quickrescue
Environment=TOWER_DB_PATH=/opt/quickrescue/tower/tower.db

ExecStart=/usr/local/bin/uvicorn tower.services.api:app --host 0.0.0.0 --port 8000 --workers 2

# Restart policy: auto-start on boot, restart on crash
Restart=always
RestartSec=3s
KillMode=process

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quickrescue-api

[Install]
WantedBy=multi-user.target
