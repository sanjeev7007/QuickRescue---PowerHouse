# ============================================================
# QuickRescue Communication Tower — Environment Configuration
# ============================================================
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env or service account JSON to git!

# --- Tower Identity ---
TOWER_ID=0x0001
TOWER_NAME=Central_Disaster_Gateway_01
TOWER_LAT=28.6139
TOWER_LON=77.2090

# --- SQLite Database ---
TOWER_DB_PATH=tower.db

# --- Firebase Service Account Credentials ---
# Absolute or relative path to your Firebase Admin SDK service account key JSON file
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=quickrescue-sih2026

# --- Sync Timing Configuration ---
SYNC_INTERVAL_ONLINE_SEC=5
SYNC_INTERVAL_OFFLINE_SEC=30
BROADCAST_POLL_INTERVAL_SEC=10
